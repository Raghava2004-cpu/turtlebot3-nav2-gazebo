<?xml version="1.0"?>
<!--
  Small static box used to test obstacle avoidance.
  This box is NOT in the saved map. The robot has to detect it
  with its LiDAR at run time and plan around it.
  Size: 0.30 m x 0.30 m x 0.30 m (red).
-->
<sdf version="1.6">
  <model name="small_box">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box><size>0.3 0.3 0.3</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.3 0.3 0.3</size></box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
